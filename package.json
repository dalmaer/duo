{
  "name": "duo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "iPhone Duo experience explorer — what an app does in each pose, emulated. See SPEC.md.",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/plates/test-ledger.mjs --test-reporter-destination=stdout 'src/**/*.test.ts' 'scripts/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "roadmap": "node ./scripts/roadmap.ts",
    "check": "npm test && npm run typecheck && npm run roadmap -- --check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
